{
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-gettext": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-tokenizer": "*",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.0",
        "laravel/tinker": "^2.8",
        "webmozart/assert": "^1.11",
        "wikimedia/composer-merge-plugin": "dev-master",
        "jbzoo/simpletypes": "^7.0",
        "kalnoy/nestedset": "^6.0",
        "cviebrock/eloquent-sluggable": "^10.0",
        "spatie/data-transfer-object": "^3.9",
        "jbzoo/data": "^7.1",
        "defstudio/telegraph": "^1.68"
    },
    "require-dev": {
        "ext-intl": "*",
        "ext-json": "*",
        "fakerphp/faker": "^1.19.1",
        "friendsofphp/php-cs-fixer": "^3.8.0",
        "jetbrains/phpstorm-attributes": "^1.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "php-standard-library/psalm-plugin": "^2.3",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^10.0",
        "psalm/plugin-laravel": "^2.8",
        "psalm/plugin-mockery": "^1.1",
        "psalm/plugin-phpunit": "^0.18.4",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ignition": "^2.0",
        "vimeo/psalm": "^5.8.0",
        "squizlabs/php_codesniffer": "^3.10",
        "pdepend/pdepend": "^2.16",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Development\\": "development/src/"
        },
        "files" : [
            "./constants.php"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "app/Ship/composer.json",
                "app/Containers/*/composer.json",
                "app/Containers/*/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-replace": true,
            "merge-scripts": false
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true,
            "composer/package-versions-deprecated": true,
            "apiato/container-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "project-install" : [
            "@php artisan key:generate",
            "@php artisan passport:keys",
            "@php artisan migrate",
            "@php artisan db:seed",
            "@php artisan apiato:permissions:toRole admin",
            "@php artisan passport:install"
        ],
        "project-update" : [
            "@php artisan migrate:fresh",
            "@php artisan db:seed",
            "@php artisan apiato:permissions:toRole admin",
            "@php artisan passport:install"
        ],
        "phpunit": "@php ./vendor/phpunit/phpunit/phpunit --configuration ./phpunit.xml",
        "phpmd": "@php ./vendor/phpmd/phpmd/src/bin/phpmd ./app text ./phpmd.xml",
        "phpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs ./app --standard=./phpcs.xml",
        "test": [
            "@phpunit",
            "@phpcs",
            "@phpmd",
            "@phpcpd"
        ]
    }
}
